@page
@model BelanjaYuk_ASPNET8_Frontend.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Buat Akun Baru - BelanjaYuk";
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
    <div class="max-w-5xl w-full bg-white rounded-2xl shadow-lg p-8 grid md:grid-cols-2 gap-8">
        <div>
            <h1 class="text-3xl font-bold text-blue-700 mb-2">BelanjaYuk</h1>
            <h2 class="text-xl font-semibold mb-4">Buat akun baru</h2>
            <p class="text-gray-500 mb-6">Isi data diri kamu untuk mulai belanja di BelanjaYuk</p>

            <form method="post" class="space-y-4">
                @if (Model.Message != null)
                {
                <div class="p-3 rounded-md bg-red-100 text-red-700">@Model.Message</div>
                }

                <div>
                    <label class="font-medium">Nama Lengkap</label>
                    <input asp-for="Input.FullName" class="w-full border rounded-lg p-2 mt-1" placeholder="Nama sesuai identitas" />
                    <span asp-validation-for="Input.FullName" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label class="font-medium">Username</label>
                    <input asp-for="Input.UserName" class="w-full border rounded-lg p-2 mt-1" placeholder="belanjayuk_user" />
                    <span asp-validation-for="Input.UserName" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label class="font-medium">Email</label>
                    <input asp-for="Input.Email" class="w-full border rounded-lg p-2 mt-1" placeholder="contoh@mail.com" />
                    <span asp-validation-for="Input.Email" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label class="font-medium">No. HP</label>
                    <input asp-for="Input.PhoneNumber" class="w-full border rounded-lg p-2 mt-1" placeholder="08xxx / +628xxx" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-red-500 text-sm"></span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="font-medium">Kata Sandi</label>
                        <input asp-for="Input.Password" type="password" class="w-full border rounded-lg p-2 mt-1" placeholder="Minimal 8 karakter" />
                    </div>
                    <div>
                        <label class="font-medium">Konfirmasi Sandi</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="w-full border rounded-lg p-2 mt-1" placeholder="Ulangi sandi" />
                    </div>
                </div>

                <div>
                    <label class="font-medium">Tanggal Lahir</label>
                    <input asp-for="Input.DOB" type="date" class="w-full border rounded-lg p-2 mt-1" />
                </div>

                <div>
                    <label class="font-medium">Jenis Kelamin</label>
                    <select asp-for="Input.IdGender" class="w-full border rounded-lg p-2 mt-1">
                        <option value="">Pilih</option>
                        <option value="id-gender-laki">Laki-laki</option>
                        <option value="id-gender-perempuan">Perempuan</option>
                    </select>
                </div>

                <details class="border rounded-lg p-3 mt-4">
                    <summary class="cursor-pointer font-semibold text-blue-600">
                        Tambahkan alamat utama (opsional)
                    </summary>
                    <div class="mt-3 grid grid-cols-2 gap-2">
                        <input asp-for="Input.Provinsi" placeholder="Provinsi" class="border rounded-lg p-2" />
                        <input asp-for="Input.KotaKabupaten" placeholder="Kota/Kabupaten" class="border rounded-lg p-2" />
                        <input asp-for="Input.Kecamatan" placeholder="Kecamatan" class="border rounded-lg p-2" />
                        <input asp-for="Input.KodePos" placeholder="Kode Pos" class="border rounded-lg p-2" />
                        <textarea asp-for="Input.HomeAddressDesc" placeholder="Alamat lengkap (≥10 karakter)" class="border rounded-lg p-2 col-span-2"></textarea>
                    </div>
                </details>

                <div class="flex items-center mt-4">
                    <input type="checkbox" required class="mr-2">
                    <span class="text-sm">Saya setuju dengan <a href="#" class="text-blue-600">Syarat & Kebijakan Privasi</a></span>
                </div>

                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg mt-4 hover:bg-blue-700">
                    Buat Akun
                </button>

                <div class="text-center mt-3">
                    <a href="/Auth/Login" class="text-blue-600 hover:underline">Sudah punya akun? Masuk</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
